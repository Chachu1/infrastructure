# Managed by Ansible - Graylog stack secrets (generated and persisted on host)
MONGO_INITDB_ROOT_USERNAME=graylog
MONGO_INITDB_ROOT_PASSWORD={{ graylog_secrets.MONGO }}

OPENSEARCH_INITIAL_ADMIN_PASSWORD={{ graylog_secrets.OS }}

GRAYLOG_PASSWORD_SECRET={{ graylog_secrets.SECRET }}
GRAYLOG_HTTP_EXTERNAL_URI={{ graylog_external_uri }}

GRAYLOG_MONGODB_URI=mongodb://graylog:{{ graylog_secrets.MONGO }}@mongodb:27017/graylog?authSource=admin

# Graylog 6.x uses the legacy `elasticsearch_*` config keys even with OpenSearch.
# Data Node must be disabled to use an external OpenSearch instance.
GRAYLOG_DATA_NODE_ENABLED=false
GRAYLOG_ELASTICSEARCH_HOSTS=http://opensearch:9200
GRAYLOG_ROOT_PASSWORD_SHA2={{ graylog_secrets.ROOT | hash('sha256') }}
