#!/usr/bin/env bash
# Managed by Ansible
# Deploy helper for {{ app_name }}.
# Usage: deploy-{{ app_name }}.sh <commit-sha>
# Immutable release deploy: fetch app repo, export the SHA into
# /opt/{{ app_name }}/releases/<sha>, build the venv, swap the current
# symlink atomically, restart the service and health-check it.
set -euo pipefail

APP_NAME="{{ app_name }}"
APP_USER="{{ app_user }}"
APP_GROUP="{{ app_group }}"
APP_PORT="{{ app_health_port }}"
HEALTH_PATH="{{ app_health_path }}"
REPO_URL="{{ app_repo_url }}"
BRANCH="{{ app_branch }}"
KEEP_RELEASES="{{ app_keep_releases }}"
BASE_DIR="/opt/${APP_NAME}"
REPO_BARE="${BASE_DIR}/shared/repo.git"

if [ "$#" -ne 1 ]; then
  echo "usage: $0 <commit-sha>" >&2
  exit 2
fi
SHA="$1"

# Serialize deploys for this app against maintenance operations.
exec 9>"/tmp/deploy-${APP_NAME}.lock"
flock -n 9 || { echo "a deploy of ${APP_NAME} is already running" >&2; exit 1; }

# Prune old releases whenever this script exits.
prune_old_releases() {
  cd "${BASE_DIR}/releases"
  ls -1dt */ | tail -n +"$(( KEEP_RELEASES + 1 ))" | xargs -r rm -rf --
}
trap 'prune_old_releases' EXIT

# 1. Ensure a bare clone of the repo exists and is current.
if [ ! -d "${REPO_BARE}" ]; then
  runuser -u "${APP_USER}" -- git clone --bare --branch "${BRANCH}" "${REPO_URL}" "${REPO_BARE}"
fi
runuser -u "${APP_USER}" -- git --git-dir="${REPO_BARE}" fetch origin --tags --prune '+refs/heads/*:refs/heads/*'

# 2. Verify the requested commit exists.
if ! runuser -u "${APP_USER}" -- git --git-dir="${REPO_BARE}" rev-parse --verify --quiet "${SHA}^{commit}" >/dev/null 2>&1; then
  echo "commit ${SHA} not found in ${REPO_URL}" >&2
  exit 1
fi

RELEASE_DIR="${BASE_DIR}/releases/${SHA}"

# 3. Export the release (idempotent - skips existing releases).
if [ ! -d "${RELEASE_DIR}" ]; then
  runuser -u "${APP_USER}" -- mkdir -p "${RELEASE_DIR}"
  runuser -u "${APP_USER}" -- bash -c "git --git-dir='${REPO_BARE}' archive '${SHA}' | tar -x -C '${RELEASE_DIR}'"
fi

# 4. Build the virtualenv (uv skips already-installed deps on re-runs).
runuser -u "${APP_USER}" -- bash -c "
  cd '${RELEASE_DIR}' &&
  uv venv venv &&
  if [ -f requirements.txt ]; then
    uv pip install --python venv/bin/python -r requirements.txt
  else
    uv pip install --python venv/bin/python .
  fi
"

# 5. Atomic symlink swap (current -> new release).
ln -sfn "${RELEASE_DIR}" "${BASE_DIR}/current.new"
mv -Tf "${BASE_DIR}/current.new" "${BASE_DIR}/current"
chown -h "${APP_USER}:${APP_GROUP}" "${BASE_DIR}/current"

# 6. Restart the service.
systemctl daemon-reload
systemctl restart "${APP_NAME}.service"

# 7. Wait for the health endpoint.
for i in $(seq 1 30); do
  if curl -fsS "http://127.0.0.1:${APP_PORT}${HEALTH_PATH}" >/dev/null 2>&1; then
    echo "deployed ${SHA} OK"
    exit 0
  fi
  sleep 2
done
echo "health check failed for ${SHA} at http://127.0.0.1:${APP_PORT}${HEALTH_PATH}" >&2
exit 1